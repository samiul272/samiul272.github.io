---
---
{% assign has_preview = false %}
{% if site.enable_publication_thumbnails and entry.preview %}
  {% assign has_preview = true %}
{% endif %}
<article
  class="bib-entry {% if has_preview %}has-preview{% else %}no-preview{% endif %}"
  itemscope
  itemtype="https://schema.org/ScholarlyArticle"
  data-topic="{{ entry.topic }}"
  data-selected="{{ entry.selected | default: 'false' }}"
  {% if entry.google_scholar_id %}
    data-scholar-id="{{ entry.google_scholar_id }}"
  {% endif %}
  data-pub-title="{{ entry.title | strip_html | escape }}"
>
  <div class="bib-aside abbr">
    {%- if entry.abbr -%}
      {%- if site.data.venues[entry.abbr] -%}
        {% assign venue_style = null %}
        {% if site.data.venues[entry.abbr].color != blank %}
          {% assign venue_style = site.data.venues[entry.abbr].color | prepend: 'style="background-color:' | append: '"' %}
        {%- endif -%}
        <abbr
          class="badge rounded"
          {% if venue_style %}
            {{ venue_style }}
          {% endif -%}
        >
          {% if site.data.venues[entry.abbr].url %}
            <a href="{{ site.data.venues[entry.abbr].url }}">{{ entry.abbr }}</a>
          {% else %}
            <span>{{- entry.abbr -}}</span>
          {% endif %}
        </abbr>
      {% else %}
        <abbr class="badge rounded">{{ entry.abbr }}</abbr>
      {% endif %}
    {% endif %}
    {% if has_preview %}
      {% assign preview_alt = 'Preview figure for ' | append: entry.title | escape %}
      {% if entry.preview contains '://' %}
        <img class="preview z-depth-1 rounded" src="{{ entry.preview }}" alt="{{ preview_alt }}">
      {% else %}
        {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {%
          include figure.liquid
          loading="lazy"
          path=entry_path
          sizes="(min-width: 640px) 140px, 45vw"
          class="preview z-depth-1 rounded"
          zoomable=true
          avoid_scaling=true
          alt=preview_alt
        %}
      {% endif %}
    {% endif %}
  </div>

  <!-- Entry bib key -->
  <div id="{{ entry.key }}" class="bib-main">
    <!-- Title -->
    <div class="title" itemprop="headline">{{ entry.title }}</div>

    <!-- Machine-readable Schema.org Microdata -->
    {%- for author in entry.author_array -%}
      {%- assign schema_author_last = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
      <meta itemprop="author" content="{{ author.first | strip_html | escape }} {{ schema_author_last | strip_html | escape }}">
    {%- endfor -%}
    {% if entry.year %}
      <meta itemprop="datePublished" content="{{ entry.year }}">
    {% endif %}
    {% if has_preview %}
      {% if entry.preview contains '://' %}
        <link itemprop="image" href="{{ entry.preview }}">
      {% else %}
        <link itemprop="image" href="{{ entry.preview | prepend: '/assets/img/publication_preview/' | absolute_url }}">
      {% endif %}
    {% endif %}
    {% assign paper_canonical_url = null %}
    {% if entry.doi %}
      {% assign paper_canonical_url = 'https://doi.org/' | append: entry.doi %}
    {% elsif entry.html %}
      {% if entry.html contains '://' %}
        {% assign paper_canonical_url = entry.html %}
      {% else %}
        {% assign paper_canonical_url = entry.html | prepend: '/assets/html/' | absolute_url %}
      {% endif %}
    {% elsif entry.arxiv %}
      {% assign paper_canonical_url = 'https://arxiv.org/abs/' | append: entry.arxiv %}
    {% elsif entry.url %}
      {% assign paper_canonical_url = entry.url %}
    {% elsif entry.pdf %}
      {% if entry.pdf contains '://' %}
        {% assign paper_canonical_url = entry.pdf %}
      {% else %}
        {% assign paper_canonical_url = entry.pdf | prepend: '/assets/pdf/' | absolute_url %}
      {% endif %}
    {% endif %}
    {% if paper_canonical_url %}
      <link itemprop="url" href="{{ paper_canonical_url }}">
      <meta itemprop="sameAs" content="{{ paper_canonical_url }}">
    {% endif %}

    <!-- Author -->
    <div class="author">
      {% assign author_array_size = entry.author_array | size %}

      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
      {% endif %}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {% assign author_is_self = false %}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {%- endif -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {% if coauthor.firstname contains author.first %}
              {%- assign coauthor_url = coauthor.url -%}
              {% break %}
            {%- endif -%}
          {% endfor %}
        {%- endif -%}

        {%- if forloop.length > 1 -%}
          {% if forloop.first == false -%}
            {%- if forloop.length > 2 %}, {% elsif forloop.length == 2 %}  {% endif %}
          {%- endif %}
          {%- if forloop.last and author_array_limit == author_array_size %}and {% endif -%}
        {% endif %}
        {%- if author_is_self -%}
          <em>
            {{- author.first }}
            {{ author_last_html -}}
          </em>
        {%- else -%}
          {%- if coauthor_url -%}
            <a href="{{ coauthor_url }}">
              {{- author.first }}
              {{ author_last_html -}}
            </a>
          {%- else -%}
            {{- author.first }}
            {{ author_last_html -}}
          {% endif %}
        {%- endif -%}
      {% endfor %}
      {%- assign more_authors = author_array_size | minus: author_array_limit -%}

      {%- assign more_authors_hide = more_authors | append: ' more author' -%}
      {% if more_authors > 0 %}
        {%- if more_authors > 1 -%}
          {% assign more_authors_hide = more_authors_hide | append: 's' %}
        {%- endif -%}
        {% assign more_authors_show = '' %}
        {%- for author in entry.author_array offset: author_array_limit -%}
          {% assign more_authors_show = more_authors_show | append: author.first | append: ' ' | append: author.last %}
          {% unless forloop.last %}
            {% assign more_authors_show = more_authors_show | append: ', ' %}
          {% endunless %}
        {%- endfor -%}
        {%- assign more_authors_show = more_authors_show | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        , and
        <span
          class="more-authors"
          title="click to view {{ more_authors_hide }}"
          onclick="
              var element = $(this);
              element.attr('title', '');
              var more_authors_text = element.text() == '{{ more_authors_hide }}' ? '{{ more_authors_show }}' : '{{ more_authors_hide }}';
              var cursorPosition = 0;
              var textAdder = setInterval(function(){
                element.html(more_authors_text.substring(0, cursorPosition + 1));
                if (++cursorPosition == more_authors_text.length){
                  clearInterval(textAdder);
                }
            }, '{{ site.more_authors_animation_delay }}');
          "
        >
          {{- more_authors_hide -}}
        </span>
      {% endif %}
      {% if entry.annotation %}
        <i
          class="fa-solid fa-circle-info ml-1"
          data-toggle="popover"
          data-placement="top"
          data-html="true"
          data-content="{{ entry.annotation | escape }}"
        >
        </i>
      {% endif %}
    </div>

    <!-- Journal/Book title and date -->
    {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
    {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
    {% if entry.type == 'article' %}
      {% capture entrytype %}<em>{{ entry.journal }}</em>{% endcapture %}
    {% elsif proceedings contains entry.type %}
      {% capture entrytype %}<em>In {{ entry.booktitle }}</em>{% endcapture %}
    {% elsif thesis contains entry.type %}
      {% capture entrytype %}<em>{{ entry.school }}</em>{% endcapture %}
    {% else %}
      {% capture entrytype %}{% endcapture %}
    {% endif %}
    {% if entry.month %}
      {% capture entrymonth %}{{ " " }}{{ entry.month | capitalize }}{% endcapture %}
    {% endif %}
    {% if entry.year %}
      {% capture entryyear %}{{ " " }}{{ entry.year }}{% endcapture %}
    {% endif %}
    {% if entry.location %}
      {% capture entrytype %}{{ entrytype }}{{ ", " }}{{ entry.location }}{% endcapture %}
    {% endif -%}
    {% if entry.additional_info %}
      {% capture entrytype %}{{ entrytype }}{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' }}{% endcapture %}
    {% endif %}
    {% capture hook_exists %}{% file_exists _includes/hook/bib.liquid %}{% endcapture %}
    {% if hook_exists == 'true' %}
      {% include hook/bib.liquid %}
    {% endif %}
    {% assign entrytype_text = entrytype | strip_html | strip %}
    {% if entrytype_text != '' %}
      <meta itemprop="isPartOf" content="{{ entrytype_text | escape }}">
    {% endif %}
    {% capture periodical %}{{ entrytype }}{% if entrytype_text != "" and entryyear != "" %}, {% endif %}{{ entrymonth }}{{ entryyear }}{% endcapture %}
    <div class="periodical">
      {{ periodical | strip }}
    </div>
    {% if entry.note %}
      <div class="periodical">
        {{ entry.note | strip }}
      </div>
    {% endif %}

    <!-- Links/Buttons -->
    <div class="links">
      {% if entry.award %}
        <button type="button" class="award btn btn-sm z-depth-0" aria-expanded="false">
          <i class="fa-solid fa-award" aria-hidden="true"></i>
          {%- if entry.award_name %}{{ entry.award_name }}{% else %}Awarded{% endif -%}
        </button>
      {% endif %}
      {% if entry.abstract %}
        <button type="button" class="abstract btn btn-sm z-depth-0" aria-expanded="false">Abstract</button>
      {% endif %}
      {% if entry.doi %}
        <a href="https://doi.org/{{ entry.doi }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">DOI</a>
      {% endif %}
      {% if entry.arxiv %}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">arXiv</a>
      {% endif %}
      {% if entry.bibtex_show %}
        <button type="button" class="bibtex btn btn-sm z-depth-0" aria-expanded="false">BibTeX</button>
      {% endif %}
      {% if entry.html %}
        {% if entry.html contains '://' %}
          <a href="{{ entry.html }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">HTML</a>
        {% else %}
          <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="btn btn-sm z-depth-0">HTML</a>
        {% endif %}
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.supp %}
        {% if entry.supp contains '://' %}
          <a href="{{ entry.supp }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Supp</a>
        {% else %}
          <a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0">Supp</a>
        {% endif %}
      {% endif %}
      {% if entry.video and site.enable_video_embedding %}
        <button type="button" class="abstract btn btn-sm z-depth-0" aria-expanded="false">Video</button>
      {% elsif entry.video %}
        <a href="{{ entry.video }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Video</a>
      {% endif %}
      {% if entry.blog %}
        <a href="{{ entry.blog }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Blog</a>
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Code</a>
      {% endif %}
      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          <a href="{{ entry.poster }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Poster</a>
        {% else %}
          <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0">Poster</a>
        {% endif %}
      {% endif %}
      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Slides</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0">Slides</a>
        {% endif %}
      {% endif %}
      {% if entry.website %}
        <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" target="_blank" rel="noopener noreferrer">Website</a>
      {% endif %}
      {% if site.data.socials.scholar_userid %}
        {% assign gs_pub = null %}
        {% if entry.google_scholar_id and site.data.google_scholar.publications %}
          {% assign gs_pub = site.data.google_scholar.publications[entry.google_scholar_id] %}
        {% endif %}
        {% assign gs_cites = gs_pub.citations | default: 0 | plus: 0 %}
        <a
          href="{% if entry.google_scholar_id %}https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.data.socials.scholar_userid }}&citation_for_view={{ site.data.socials.scholar_userid }}:{{ entry.google_scholar_id }}{% else %}https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}{% endif %}"
          class="btn btn-sm z-depth-0 scholar-cite-btn{% if gs_cites > 0 %} has-citations{% endif %}"
          target="_blank"
          rel="noopener noreferrer"
          {% if gs_cites > 0 %}
            title="Cited by {{ gs_cites }} on Google Scholar"
          {% elsif entry.google_scholar_id %}
            title="View publication record on Google Scholar"
          {% else %}
            hidden
          {% endif %}
        >
          <i class="ai ai-google-scholar" aria-hidden="true"></i>
          <span class="scholar-cite-text">
            {%- if gs_cites > 0 %}Cited by {{ gs_cites }}{% else %}Scholar{% endif -%}
          </span>
        </a>
      {% endif %}
    </div>

    {% if entry.award %}
      <!-- Hidden Award block -->
      <div class="award hidden d-print-inline">
        <p>{{ entry.award | markdownify }}</p>
      </div>
    {% endif %}

    {% if entry.abstract %}
      <!-- Hidden abstract block -->
      <div class="abstract hidden">
        <p itemprop="abstract">{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.bibtex_show %}
      <!-- Hidden bibtex block -->
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
      {% endhighlight %}
      </div>
    {% endif %}

    {% if entry.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div class="abstract hidden">
        <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
      </div>
    {% endif %}
  </div>
</article>
