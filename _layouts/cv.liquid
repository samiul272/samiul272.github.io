---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    <header class="post-header cv-header-bar">
      <div>
        <h1 class="post-title">{{ page.title }}</h1>
        {% if page.description %}
          <p class="post-description">{{ page.description }}</p>
        {% endif %}
      </div>
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary-cta"
        >
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
          <span>Download PDF Resume</span>
        </a>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for entry in site.data.cv %}
          <a class="anchor" id="{{ entry.title | slugify }}"></a>
          <div class="card mt-3 p-3">
            <h2 class="card-title">{{ entry.title }}</h2>
            <div>
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <div class="post">
    <header class="post-header cv-header-bar">
      <div>
        <h1 class="post-title">{{ page.title }}</h1>
        {% if page.description %}
          <p class="post-description">{{ page.description }}</p>
        {% endif %}
      </div>
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary-cta"
        >
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
          <span>Download PDF Resume</span>
        </a>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for data in site.data.resume %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          {% case data[0] %}
            {% when 'basics' %}
              {% assign section_title = 'Summary' %}
            {% when 'work' %}
              {% assign section_title = 'Experience' %}
            {% when 'education' %}
              {% assign section_title = 'Education' %}
            {% when 'skills' %}
              {% assign section_title = 'Core Areas & Skills' %}
            {% when 'projects' %}
              {% assign section_title = 'Selected Systems & Benchmarks' %}
            {% when 'awards' %}
              {% assign section_title = 'Honors & Awards' %}
            {% else %}
              {% assign section_title = data[0] | capitalize %}
          {% endcase %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            <h2 class="card-title">{{ section_title }}</h2>
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}
