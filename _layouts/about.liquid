---
layout: default
---
<section class="hero-section" aria-label="Introduction">
  <div class="hero-grid">
    <div class="hero-copy">
      {% if page.role_badge %}
        <div class="hero-status-pill">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{{ page.role_badge }}</span>
        </div>
      {% endif %}

      <h1 class="hero-title">
        {% if site.title == 'blank' or site.title == blank %}
          {{ site.first_name }}
          {% if site.middle_name %}{{ site.middle_name }}{% endif %}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      {% if page.subtitle %}
        <p class="hero-subtitle">{{ page.subtitle }}</p>
      {% endif %}

      <div class="hero-bio">{{ content }}</div>

      {% if page.affiliations %}
        <div class="hero-affiliations" aria-label="Affiliations and honors">
          {% for item in page.affiliations %}
            <span class="affiliation-pill" title="{{ item.role }}">
              <i class="{{ item.icon }}" aria-hidden="true"></i>
              <span>{{ item.name }}</span>
            </span>
          {% endfor %}
        </div>
      {% endif %}

      <div class="hero-actions">
        <a class="btn-primary-cta" href="{{ '/publications/' | relative_url }}">
          <i class="fa-solid fa-book-open" aria-hidden="true"></i>
          <span>Publications</span>
        </a>
        <a class="btn-secondary-cta" href="{{ '/cv/' | relative_url }}">
          <i class="fa-regular fa-file-pdf" aria-hidden="true"></i>
          <span>CV / Resume</span>
        </a>
        {% if site.data.socials.scholar_userid %}
          <a
            class="icon-chip-link"
            href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
            aria-label="Google Scholar"
            title="Google Scholar"
          >
            <i class="ai ai-google-scholar" aria-hidden="true"></i>
            <span>Scholar</span>
          </a>
        {% endif %}
        {% if site.data.socials.github_username %}
          <a
            class="icon-chip-link"
            href="https://github.com/{{ site.data.socials.github_username }}"
            aria-label="GitHub"
            title="GitHub"
          >
            <i class="fa-brands fa-github" aria-hidden="true"></i>
          </a>
        {% endif %}
        {% if site.data.socials.linkedin_username %}
          <a
            class="icon-chip-link"
            href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
          </a>
        {% endif %}
        <a class="icon-chip-link" href="mailto:samiul272@gmail.com" aria-label="Email Samiul Alam" title="Email">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    {% if page.profile %}
      <div class="hero-portrait-column">
        <div class="hero-portrait-card">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% capture sizes %}(min-width: 820px) 310px, 90vw{% endcapture %}
            {%
              include figure.liquid
              fetchpriority="high"
              loading="eager"
              path=profile_image_path
              width="800"
              height="880"
              sizes=sizes
              alt="Samiul Alam — Software Engineer at Google and AI Researcher"
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="hero-location-bar">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{{ page.profile.more_info }}</span>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% if page.research_pillars %}
  <section class="home-section" aria-labelledby="heading-research-focus">
    <div class="section-header">
      <h2 id="heading-research-focus">Research &amp; Engineering Focus</h2>
    </div>
    <div class="bento-grid">
      {% for pillar in page.research_pillars %}
        <article class="bento-card">
          <div>
            <div class="bento-card-top">
              <span class="bento-icon" aria-hidden="true"><i class="{{ pillar.icon }}"></i></span>
              <h3>{{ pillar.title }}</h3>
            </div>
            <p>{{ pillar.summary }}</p>
          </div>
          {% if pillar.tags %}
            <div class="tag-list">
              {% for tag in pillar.tags %}
                <span class="tag-chip">{{ tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% if page.announcements and page.announcements.enabled %}
  <section class="home-section" aria-labelledby="heading-recent-news">
    <div class="section-header">
      <h2 id="heading-recent-news">
        <a href="{{ '/news/' | relative_url }}">Recent News &amp; Milestones</a>
      </h2>
      <a class="section-link" href="{{ '/news/' | relative_url }}"> All updates <i class="fa-solid fa-arrow-right" aria-hidden="true"></i> </a>
    </div>
    {% include news.liquid limit=true %}
  </section>
{% endif %}

{% if page.selected_papers %}
  <script src="{{ '/assets/js/scholar-metrics.js' | relative_url | bust_file_cache }}" type="module"></script>
  <section class="home-section" aria-labelledby="heading-selected-papers">
    <div class="section-header">
      <h2 id="heading-selected-papers">
        <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
      </h2>
      <a class="section-link" href="{{ '/publications/' | relative_url }}">
        View all publications <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    {% include selected_papers.liquid %}
  </section>
{% endif %}
