<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <ol class="news-timeline {% if include.limit and page.announcements.scrollable and news_size > 3 %}news-scrollable{% endif %}">
      {% for item in news limit: news_limit %}
        <li class="news-item">
          <div class="news-item-inner">
            <time class="news-date" datetime="{{ item.date | date: '%Y-%m-%d' }}">
              {{ item.date | date: '%b %d, %Y' }}
            </time>
            <div class="news-body">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
