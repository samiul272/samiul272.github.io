<ul class="card-text list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="cv-entry-grid">
        <div class="cv-entry-meta">
          {% if content.startDate and content.startDate != '' %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            <span class="cv-date-pill">{{ startDate }} – {{ endDate }}</span>
          {% endif %}
          {% if content.location %}
            <p class="cv-location">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{{ content.location }}</span>
            </p>
          {% endif %}
        </div>
        <div class="cv-entry-body">
          <h3 class="cv-entry-title">
            {% if content.url and content.url != '' %}
              <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.studyType }} in {{ content.area }}</a>
            {% else %}
              {{ content.studyType }} in {{ content.area }}
            {% endif %}
          </h3>
          <div class="cv-entry-org">{{ content.institution }}</div>
          {% if content.score and content.score != '' %}
            <p class="cv-entry-summary">{{ content.score }}</p>
          {% endif %}
          {% if content.courses and content.courses.size > 0 %}
            <ul class="cv-entry-highlights">
              {% for item in content.courses %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
