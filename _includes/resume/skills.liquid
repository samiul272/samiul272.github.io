<div class="cv-skills-grid">
  {% for content in data[1] %}
    <div class="cv-skill-card">
      <h3 style="font-size: 0.96rem; margin-bottom: 0.6rem;">{{ content.name }}</h3>
      <div class="cv-skill-chips">
        {% for item in content.keywords %}
          <span class="skill-chip">{{ item }}</span>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
