<div class="cv-basics-grid">
  {% assign basics = data[1] %}
  {% if basics.name != '' %}
    <div class="cv-basics-item">
      <span class="cv-basics-label">Name</span>
      <span class="cv-basics-value">{{ basics.name }}</span>
    </div>
  {% endif %}
  {% if basics.label != '' %}
    <div class="cv-basics-item">
      <span class="cv-basics-label">Role</span>
      <span class="cv-basics-value">{{ basics.label }}</span>
    </div>
  {% endif %}
  {% if basics.location.city != '' %}
    <div class="cv-basics-item">
      <span class="cv-basics-label">Location</span>
      <span class="cv-basics-value">{{ basics.location.city }}, {{ basics.location.region }}</span>
    </div>
  {% endif %}
  {% if basics.email != '' %}
    <div class="cv-basics-item">
      <span class="cv-basics-label">Email</span>
      <span class="cv-basics-value"
        ><a href="mailto:{{ basics.email }}">{{ basics.email }}</a></span
      >
    </div>
  {% endif %}
  {% if basics.url != '' %}
    <div class="cv-basics-item">
      <span class="cv-basics-label">Website</span>
      <span class="cv-basics-value">
        <a href="{{ basics.url }}" target="_blank" rel="noopener noreferrer">{{ basics.url }}</a>
      </span>
    </div>
  {% endif %}
  {% if basics.profiles and basics.profiles.size > 0 %}
    <div class="cv-basics-item">
      <span class="cv-basics-label">Profiles</span>
      <div class="cv-skill-chips">
        {% for profile in basics.profiles %}
          <a class="skill-chip" href="{{ profile.url }}" target="_blank" rel="noopener noreferrer">
            {{ profile.network }}
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>
{% if basics.summary != '' %}
  <p class="cv-basics-summary">
    {{ basics.summary }}
  </p>
{% endif %}
