<ul class="card-text list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="cv-entry-grid">
        <div class="cv-entry-meta">
          {% if content.date %}
            {% assign date = content.date | split: '-' | slice: 0, 2 | join: '.' %}
            <span class="cv-date-pill">{{ date }}</span>
          {% endif %}
        </div>
        <div class="cv-entry-body">
          <h3 class="cv-entry-title">
            {% if content.url and content.url != '' %}
              <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.title }}</a>
            {% else %}
              {{ content.title }}
            {% endif %}
          </h3>
          {% if content.awarder %}
            <div class="cv-entry-org">{{ content.awarder }}</div>
          {% endif %}
          {% if content.summary %}
            <p class="cv-entry-summary mb-0">{{ content.summary }}</p>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
